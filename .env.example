# متجر صُدْفَة للساعات (Sodfa Watch Store) - 2026 Environment Configuration
# 100% Free Production Backend: Vercel Serverless Functions + Turso LibSQL + Cloudinary

# 1. Turso Database (LibSQL Cloud - 100% Free Tier: 9GB storage, 500 databases)
# Create your free database: turso db create sodfa-db && turso db tokens create sodfa-db
TURSO_DATABASE_URL=libsql://your-database-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-database-auth-token

# 2. Admin Security & JWT Session
SODFA_ADMIN_SECRET=sodfa-master-secret-key-2026
ADMIN_JWT_SECRET=sodfa-master-secret-key-2026

# 3. Cloudinary (Free 25GB Storage & Unlimited CDN Bandwidth)
# Optional: for signed direct media uploads. (You can also configure unsigned preset in Admin settings)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_UPLOAD_PRESET=sodfa_watches

# 4. Optional Webhooks for New Order Alerts
# Web3Forms Email Key (https://web3forms.com)
WEB3FORMS_ACCESS_KEY=

# Telegram Bot Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
