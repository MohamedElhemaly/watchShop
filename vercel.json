{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/admin/(.*)", "destination": "/admin.html" },
    { "source": "/product", "destination": "/product.html" },
    { "source": "/product.html", "destination": "/product.html" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
